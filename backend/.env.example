PORT=5001
NODE_ENV=development

# JSON Web Tokens Secrets (min 32 characters each)
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/nestmate

# Resend Mailer Configuration
# Get an API key at https://resend.com (optional in dev, required in production)
RESEND_API_KEY=
# Sender email address verified in Resend (e.g. NestMate <onboarding@resend.dev> or noreply@yourdomain.com)
MAIL_FROM=NestMate <onboarding@resend.dev>
# Frontend Application URL used exclusively to build action links (verify email, reset password)
APP_URL=http://localhost:5173

# Allowed Origins for CORS / CSRF verification (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001

# Fast2SMS Configuration (optional)
FAST2SMS_API_KEY=

# Nodemailer Configuration (legacy fallback)
MAIL_USER=
MAIL_PASS=
